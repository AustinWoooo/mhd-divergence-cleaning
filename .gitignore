# CMake build directory
build/
build-*/

# Compiled objects and libraries
*.o
*.a
*.so
*.dylib
*.dll
*.exe

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Python cache
__pycache__/
*.pyc

# Generated sweep/smoke outputs from running executables at the repo root.
# Existing tracked curated CSVs remain tracked; these rules only prevent new
# transient outputs from appearing as untracked files.
results/mhd_sweep_mpi/
results/mhd_runner/*/*_smoke_*.csv
results/mhd_runner/*/mpi_*.csv
results/mhd_runner/*/mpi_smoke_*.csv
results/mhd_runner/*/mpi_ot_full_*.csv
results/mhd_runner/*/mpi_otfull_*.csv
results/mhd_runner/divergence/mhd_fl_conv_*.csv
results/mhd_runner/snapshots/mhd_fl_conv_*_final.csv
results/mhd_runner/summaries/mhd_fl_conv_*_summary.csv

# Editor files
.vscode/
.idea/
.venv/
*~
.DS_Store
