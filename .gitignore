# CMake build directory
build/
build-*/

# Compiled objects and libraries
*.o
*.a
*.so
*.dylib
*.dll
*.exe

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Python cache
__pycache__/
*.pyc

# Generated sweep/smoke outputs from running executables at the repo root.
# Existing tracked curated CSVs remain tracked; these rules only prevent new
# transient outputs from appearing as untracked files.
results/mhd_sweep_mpi/
results/mhd_runner/*/*_smoke_*.csv
results/mhd_runner/*/mpi_*.csv
results/mhd_runner/*/mpi_smoke_*.csv
results/mhd_runner/*/mpi_ot_full_*.csv
results/mhd_runner/*/mpi_otfull_*.csv
results/mhd_runner/divergence/perf_*.csv
results/mhd_runner/summaries/perf_*_summary.csv
results/mhd_runner/snapshots/perf_*_final.csv
results/mhd_runner/divergence/mhd_fl_conv_*.csv
results/mhd_runner/snapshots/mhd_fl_conv_*_final.csv
results/mhd_runner/summaries/mhd_fl_conv_*_summary.csv

# Editor files
.vscode/
.idea/
.venv/
*~
.DS_Store
# Root CMake/CTest files from accidental in-source configure
CTestTestfile.cmake
DartConfiguration.tcl
Testing/

# Generated dependency graphs
*.dot
file_dependencies*.png
link_dependencies*.png
project_deps*.png
project_deps*.dot

# Local tool/editor metadata
.claude/
.agents/
.codex/

# Large regenerated 2D GLM full-field snapshots; compact divergence CSVs are tracked.
results/glm_2d/snapshots/glm_2d_*_final.csv

# Large MHD runner snapshots not required by the standard canonical snapshot figures.
results/mhd_runner/snapshots/mhd_da_hyperbolic_glm_final.csv
results/mhd_runner/snapshots/mhd_da_mixed_eglm_final.csv
results/mhd_runner/snapshots/mhd_da_gi_mixed_eglm_final.csv
results/mhd_runner/snapshots/mhd_da_parabolic_final.csv
results/mhd_runner/snapshots/mhd_da_elliptic_projection_final.csv
results/mhd_runner/snapshots/mhd_fl_hyperbolic_glm_final.csv
results/mhd_runner/snapshots/mhd_fl_mixed_eglm_final.csv
results/mhd_runner/snapshots/mhd_fl_gi_mixed_eglm_final.csv

# Raw benchmarking/sweep inventories and per-run diagnostics. Curated aggregate
# CSVs, figures, and selected summary outputs remain eligible for tracking.
figures/visual_inventory/
results/performance/runs/
results/performance/runs_*/
results/performance/*_raw.csv
results/performance/*.log
results/openmp_scaling_runs/
results/mhd_runner/glm_sweep/ot_runs/
results/mhd_runner/projection_acausality/projection_diagnostics/*_step*_sub*.csv
results/mhd_runner/failures/perf_*_failure.csv
results/mhd_runner/failures/perf_*_first_bad_cell_diagnostic.csv
